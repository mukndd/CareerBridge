# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=https://<your-frontend-vercel-domain>

# ── Database (Supabase) ─────────────────────────────────────────────────────────
# Use the Transaction pooler URL (port 6543) for serverless/Vercel deployments
# Find it in Supabase dashboard → Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# ── Redis (Upstash) ─────────────────────────────────────────────────────────────
# Create a free Redis database at https://upstash.com
# Use the Redis endpoint details from Upstash dashboard
REDIS_HOST=<upstash-hostname>.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=<upstash-password>

# ── JWT ─────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=<generate-random-32-char-string>
JWT_REFRESH_SECRET=<generate-another-random-32-char-string>
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── Anthropic (Claude) ──────────────────────────────────────────────────────────
# Get your API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── File Storage ────────────────────────────────────────────────────────────────
# /tmp is writable in Vercel serverless (ephemeral between invocations)
STORAGE_PROVIDER=local
LOCAL_UPLOAD_PATH=/tmp/uploads
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,docx,doc,png,jpg,jpeg

# ── Rate Limiting ───────────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
